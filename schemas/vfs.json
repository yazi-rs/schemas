{
	"$id": "https://yazi-rs.github.io/schemas/vfs.json",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"default": "https://yazi-rs.github.io/schemas/vfs.schema.json",
			"type": "string"
		}
	},
	"patternProperties": {
		"^[-a-z0-9]{1,20}$": {
			"type": "object",
			"patternProperties": {
				"^[-a-z0-9*]{1,20}$": { "$ref": "#/$defs/provider" }
			},
			"additionalProperties": false
		}
	},
	"$defs": {
		"provider": {
			"type": "object",
			"properties": {
				"kind": { "type": "string" },
				"run": { "type": "string" }
			},
			"required": ["kind", "run"]
		}
	}
}
